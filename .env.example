DATABASE_URL=postgresql+psycopg://contest:contest@localhost:55432/contest
JWT_SECRET=replace-this-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=60
JUDGE_IMAGE=contest-python:3.12
JUDGE_TIMEOUT_SECONDS=3
JUDGE_MAX_OUTPUT_BYTES=65536
JUDGE_MAX_ATTEMPTS=3
JUDGE_LEASE_SECONDS=60
JUDGE_TEMP_DIR=/tmp/contest-judge
LOG_LEVEL=INFO
